extends "res://tools/debug/first_morning_check.gd"
var out := "res://docs/world/riverfront-quay-2026-10-08/rerun/"
const FLAGS := ["pouch_accepted","delivered","heard_calls","water_mark_observed","marker_restored","report_done","city_arrival_registered"]
func capture(label: String) -> void:
    await RenderingServer.frame_post_draw
    root.get_texture().get_image().save_png(out+"/"+label+".png")
func flags() -> Dictionary:
    var result := {}
    for flag in FLAGS: result[flag] = journey.route.get(flag)
    return result
func push(action: String, count: int) -> void:
    Input.action_press(action)
    await frames(count)
    release()
    await frames(3)
func _run() -> void:
    var args := OS.get_cmdline_user_args()
    if not args.is_empty():out=args[0]
    if "female" in args:model="Female"
    DirAccess.make_dir_recursive_absolute(out)
    root.size = Vector2i(1152,648)
    root.content_scale_size = Vector2i(1152,648)
    journey = load("res://scenes/world_journey.tscn").instantiate()
    journey.initial_area = "riverfront"
    journey.courier_model = model
    root.add_child(journey)
    current_scene = journey
    await frames(35)
    var quay: Node2D = journey.active_area.quay_activity
    var party: Node = root.get_node("PlayerParty")
    var member: Object = party.active_member()
    var original_flags := flags()
    verify("Riverfront attaches quay and preserves courier",quay != null and player().chibi_model == model)
    verify("Reach quay board from real bridge arrival",await walk(Vector2(368,512)) and await walk(Vector2(368,472)))
    await key(KEY_E)
    verify("Board introduces optional round without changing main objective",quay.started and journey.route._panel.visible and flags()==original_flags)
    await capture("quay-board")
    await key(KEY_M)
    verify("Map cannot interrupt quay dialogue",not journey.atlas.opened)
    var before := player().position
    await push("move_down",12)
    verify("Dialogue blocks movement",player().position==before)
    await key(KEY_E)
    verify("Close dialogue restores walking",player().is_physics_processing())
    await key(KEY_E)
    verify("Incomplete round does not open gate",not quay.completed and not quay._gate.get_node("CollisionShape2D").disabled)
    await key(KEY_E)
    verify("Reach branch gate approach",await walk(Vector2(368,512)) and await walk(Vector2(608,512)) and await walk(Vector2(608,556)))
    await key(KEY_E)
    verify("Gate notice explains open side paths",journey.route._panel.visible)
    await key(KEY_E)
    await push("move_down",40)
    verify("Closed gate physically blocks shortcut",player().position.y < 576)
    verify("Reach garden through western side path",await walk(Vector2(608,552)) and await walk(Vector2(432,552)) and await walk(Vector2(432,680)) and await walk(Vector2(688,680)))
    await key(KEY_E)
    verify("Garden can be first observation",quay.observed.size()==1 and quay.observed.has("quay_garden"))
    await capture("garden-observation")
    await key(KEY_E)
    await key(KEY_E)
    verify("Repeated observations are idempotent",quay.observed.size()==1)
    await key(KEY_E)
    verify("Garden west loop connects lower promenade",await walk(Vector2(432,680)) and await walk(Vector2(248,680)) and await walk(Vector2(248,512)))
    verify("Promenade reaches actual landing deck",await walk(Vector2(248,416)) and await walk(Vector2(248,336)) and await walk(Vector2(168,336)))
    await key(KEY_E)
    verify("Landing records gauge observation",quay.observed.size()==2 and quay.observed.has("quay_landing"))
    await capture("landing-observation")
    await key(KEY_E)
    await push("move_up",40)
    verify("Landing north rail blocks entry into water",player().position.y>=311)
    verify("Landing remains traversable behind rail",await walk(Vector2(176,348)))
    await push("move_left",55)
    verify("Landing end blocks west water",player().position.x>=133)
    verify("Return from end of landing",await walk(Vector2(176,348)))
    await push("move_down",40)
    verify("Landing south rail blocks water",player().position.y<=365)
    verify("Promenade continues above landing",await walk(Vector2(248,336)) and await walk(Vector2(248,240)))
    await push("move_left",45)
    verify("Bank outside landing remains solid",player().position.x>=229)
    verify("Court connects landing and goods shop",await walk(Vector2(248,416)) and await walk(Vector2(768,416)) and await walk(Vector2(768,296)))
    await key(KEY_E)
    verify("Goods observation completes three distinct stops",quay.observed.size()==3 and not quay.completed)
    await capture("goods-observation")
    await key(KEY_E)
    verify("Return to board through branch court",await walk(Vector2(768,424)) and await walk(Vector2(416,424)) and await walk(Vector2(368,472)))
    await key(KEY_E)
    await frames(3)
    verify("Returning three observations opens visible and physical gate",quay.completed and quay._gate.get_node("CollisionShape2D").disabled and not quay._gate_art[0].visible)
    await capture("round-complete")
    await key(KEY_E)
    verify("Opened shortcut is really walkable",await walk(Vector2(448,512)) and await walk(Vector2(608,512)) and await walk(Vector2(608,680)))
    await capture("shortcut-open")
    verify("Garden east opening and relay road remain clear",await walk(Vector2(832,680)) and await walk(Vector2(832,512)) and await walk(Vector2(988,512)))
    verify("Actual east exit reaches relay yard",await gate("move_right","relay_yard"))
    verify("Actual yard return reaches riverfront",await walk(Vector2(32,488)) and await gate("move_left","riverfront"))
    verify("Cached quay retains completed observations and open gate",journey.active_area.quay_activity==quay and quay.observed.size()==3 and quay.completed and quay._gate.get_node("CollisionShape2D").disabled)
    verify("Old city approach remains clear",await walk(Vector2(880,512)) and await walk(Vector2(880,40)))
    verify("Actual north exit reaches historic street",await gate("move_up","historic_street"))
    verify("Actual historic return reaches riverfront",await walk(Vector2(384,872)) and await gate("move_down","riverfront"))
    verify("Westbound bridge road remains clear",await walk(Vector2(880,512)) and await walk(Vector2(40,512)))
    verify("Actual west exit reaches levee",await gate("move_left","route1"))
    verify("Levee bridge returns to riverfront",await walk(Vector2(664,416)) and await gate("move_right","riverfront"))
    verify("Side round preserves party and main delivery flags",party.active_member()==member and flags()==original_flags)
    await key(KEY_M)
    verify("Region map still opens after all new interactions",journey.atlas.opened)
    await key(KEY_ESCAPE)
    verify("Region map restores control",player().is_physics_processing())
    var walker: Sprite2D = quay._walker
    journey.reduced_motion = true
    var still := walker.position
    await frames(35)
    verify("Reduced motion stops ambient walker",walker.position==still)
    journey.reduced_motion = false
    await frames(180)
    verify("Ambient walker uses its lane",walker.position.x>=640 and walker.position.x<=840 and walker.position.y==426)
    verify("Ambient animation resumes",walker.position != still)
    FileAccess.open(out+"/checks.json",FileAccess.WRITE).store_string(JSON.stringify({"checks":checks,"failures":failures},"  "))
    print("RESULT ",checks.size()," checks / ",failures.size()," failures")
    release()
    journey.queue_free()
    await frames(4)
    quit(0 if failures.is_empty() else 1)
